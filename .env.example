# ==============================================================================
# Copy to .env.local and fill in. Vars WITHOUT NEXT_PUBLIC_ are server-only —
# never referenced from a "use client" component (see lib/supabase/admin.ts
# for how that's enforced for the Supabase secret key).
# ==============================================================================

# ---- Supabase (Phase 1) -----------------------------------------------------
# Project URL and public API keys — Settings > API in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=
# "Publishable" key (current naming; the legacy equivalent is the anon key —
# both work today, Supabase is mid-migration off anon/service_role naming).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# "Secret" key (current naming; legacy equivalent: service_role key).
# SERVER-ONLY. Bypasses RLS. Only imported via lib/supabase/admin.ts.
SUPABASE_SECRET_KEY=

# ---- Cloudflare R2 (Phase 2) -------------------------------------------------
# R2 dashboard > Manage API Tokens. Scope the token to the two buckets below.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Private bucket for raw user-uploaded source photos.
R2_UPLOADS_BUCKET=uploads
# Public bucket for generated .glb/.usdz model files.
R2_MODELS_BUCKET=models
# Custom domain (cdn.<yourdomain>) fronting R2_MODELS_BUCKET — never serve
# models from the rate-limited *.r2.dev domain in production. Live in
# Vercel production (see README "R2 setup"); left unset here on purpose —
# local dev falls back to the /api/models proxy route instead, so running
# the app doesn't require owning a Cloudflare-zoned domain.
NEXT_PUBLIC_MODELS_CDN_URL=

# Chrome Web Store listing URL for the extension (extension/). Left unset
# here on purpose — the extension is still an unpacked 0.1.0 dev build, not
# published yet. Until this is set, DesktopEntryChoice.tsx's landing-page
# "Chrome-д нэмэх" step shows a "Тун удахгүй" badge instead of a dead link.
NEXT_PUBLIC_CHROME_STORE_URL=

# ---- Tripo (Image -> 3D provider) (Phase 3) ----------------------------------
TRIPO_API_KEY=
# Signing secret for verifying Tripo webhook deliveries (Tripo-Webhook-Signature
# header). NOT a request field — Tripo V3 has no per-request callback_url; the
# webhook URL and this secret are both configured in the Tripo developer
# console (Settings > Webhooks). Copy the whsec_... value shown there.
TRIPO_WEBHOOK_SECRET=
# AI model version passed to Tripo's image-to-model call. Defaults to
# v3.1-20260211 in code if unset — Tripo's current H3-family endpoint, the
# only one that accepts texture_quality/geometry_quality/face_limit/etc (see
# lib/tripo.ts). Override only if you deliberately want the older legacy
# path, which silently ignores all of those.
TRIPO_MODEL_VERSION=
# Public base URL of this deployment (e.g. https://yourapp.vercel.app).
# Required once GENERATION_PROVIDER=fal: lib/fal.ts uses it to build the
# fal_webhook callback URL, and app/api/webhooks/fal/route.ts uses it to
# build a public URL to our own uploaded GLB (fed into Tripo's USDZ
# conversion task — see lib/tripo.ts submitUsdzConversionTask).
NEXT_PUBLIC_APP_URL=

# ---- fal.ai / TRELLIS.2 (alternative image -> 3D provider) ------------------
# Secondary GLB-generation provider, selected per-request by
# GENERATION_PROVIDER below (lib/generateModel.ts). Runs Microsoft's
# TRELLIS.2 (MIT-licensed, higher image-to-3D fidelity per published
# benchmarks than Tripo's model) as a hosted fal.ai endpoint — no self-hosted
# GPU to run or keep online. fal never produces USDZ; that half of the
# pipeline still goes through Tripo's /models/convert task regardless of
# which provider generated the GLB, so TRIPO_API_KEY above is still required
# even with GENERATION_PROVIDER=fal.
#
# Which provider new single-photo generations use. "tripo" (default/unset,
# fail-safe) or "fal". Multiview (left/back/right photos) always uses Tripo
# regardless of this setting — fal's trellis-2 endpoint has no multiview
# input.
GENERATION_PROVIDER=
# fal.ai dashboard > Keys.
FAL_API_KEY=

# ---- Stale-generation sweep --------------------------------------------------
# Secures app/api/cron/sweep-stale-generations/route.ts — Vercel sends this
# back as the cron invocation's own Authorization: Bearer <value> header
# automatically (see vercel.json). Generate with, e.g., `openssl rand -hex 32`.
CRON_SECRET=

# ---- wire.mn (credit purchases) ---------------------------------------------
# Stripe doesn't operate in Mongolia — wire.mn is the payment gateway used
# instead (merchant account approved 2026-08-29). Dashboard > project > API
# keys. sk_test_... for local dev (sandbox, never moves real money —
# docs.wire.mn/docs/concepts/test-mode); sk_live_... in production.
WIRE_API_KEY=
# Signing secret for verifying wire.mn webhook deliveries
# (WirePayment-Signature header) — shown ONCE when the webhook endpoint is
# created in the dashboard (or via the API, see lib/wire.ts). Copy the
# whsec_... value immediately; it can't be retrieved again, only rotated.
WIRE_WEBHOOK_SECRET=
